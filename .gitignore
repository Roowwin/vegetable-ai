# ============================================
# VeggieOps AI — Git Ignore Rules
# ============================================
# This file tells Git which files to NEVER track.
# Edit carefully — patterns are case-sensitive on Linux/macOS.

# --------------------------------------------
# Python
# --------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# pyenv
.python-version

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py

# mypy / linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# --------------------------------------------
# Node / Frontend
# --------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
.next/
out/
build/
dist/

# Testing
coverage/

# --------------------------------------------
# Environment & Secrets (NEVER commit)
# --------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
config/local.yaml
config/local.json

# --------------------------------------------
# Databases & Data
# --------------------------------------------
*.db
*.sqlite
*.sqlite3
data/local/
data/raw/
data/processed/
data/synthetic/*.csv
!data/synthetic/.gitkeep

# ML model artifacts (large binary files)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
!models/.gitkeep

# --------------------------------------------
# Docker
# --------------------------------------------
.docker/
docker-compose.override.yml

# --------------------------------------------
# IDE & Editors
# --------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------
# Logs
# --------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------
# OS
# --------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --------------------------------------------
# Project-specific
# --------------------------------------------
# Ollama model cache (if mounted locally)
.ollama/
# Temporary AI response cache
.ai_cache/
# Generated synthetic data backups
backups/*.sql
!backups/.gitkeep
